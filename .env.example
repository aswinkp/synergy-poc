# Required. Keep the real key in your local environment or secret manager.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.6-luna

# Required unless an .xlsx workbook is placed in the repository root.
EXCEL_PATH=/absolute/path/to/learning-report.xlsx

# Optional enrichment source. Enables workforce, demographic, tenure, and reporting-line analysis.
HEADCOUNT_EXCEL_PATH=/absolute/path/to/headcount-report.xlsx

# Optional. The parent directory is created automatically.
DATABASE_PATH=./data/learning_chat.db

# Optional. Generated CSV/XLSX downloads are stored here and removed with their chat.
EXPORTS_PATH=./data/exports

# Required. Generate with: openssl rand -hex 32
AUTH_SECRET=

# Authentication session settings. Set cookie security to true behind HTTPS.
AUTH_TOKEN_TTL_HOURS=12
AUTH_COOKIE_SECURE=false

# Optional. Includes generated SQL in API results for local debugging.
# APP_DEBUG=1
