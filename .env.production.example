# Public DNS name routed to the VPS. Do not include https:// or a path.
APP_DOMAIN=synergy.example.com
APP_VERSION=main

# Generated on the server by deploy/configure-env.sh.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.6-luna
AUTH_SECRET=
AUTH_TOKEN_TTL_HOURS=12
AUTH_COOKIE_SECURE=true

# Container paths. Normally leave these unchanged.
EXCEL_PATH=/app/input/learning.xlsx
HEADCOUNT_EXCEL_PATH=/app/input/headcount.xlsx
DATABASE_PATH=/app/data/learning_chat.db
EXPORTS_PATH=/app/data/exports
